{
  "name": "@timeui/icons",
  "version": "1.3.1",
  "description": "TimeUI icon set — tree-shakeable React components generated from SVGs.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "prebuild": "node ./scripts/generate.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "rimraf": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
