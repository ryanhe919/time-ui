{
  "name": "@timeui/react",
  "version": "2.0.2",
  "description": "TimeUI — enterprise-grade React component library.",
  "license": "MIT",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "emotion",
    "timeui"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./code-block": {
      "types": "./dist/code-block.d.ts",
      "import": "./dist/code-block.js",
      "require": "./dist/code-block.cjs"
    },
    "./chat-markdown": {
      "types": "./dist/chat-markdown.d.ts",
      "import": "./dist/chat-markdown.js",
      "require": "./dist/chat-markdown.cjs"
    },
    "./rich-text-editor": {
      "types": "./dist/rich-text-editor.d.ts",
      "import": "./dist/rich-text-editor.js",
      "require": "./dist/rich-text-editor.cjs"
    },
    "./code-editor": {
      "types": "./dist/code-editor.d.ts",
      "import": "./dist/code-editor.js",
      "require": "./dist/code-editor.cjs"
    },
    "./pdf-viewer": {
      "types": "./dist/pdf-viewer.d.ts",
      "import": "./dist/pdf-viewer.js",
      "require": "./dist/pdf-viewer.cjs"
    },
    "./markdown-viewer": {
      "types": "./dist/markdown-viewer.d.ts",
      "import": "./dist/markdown-viewer.js",
      "require": "./dist/markdown-viewer.cjs"
    },
    "./test-utils": {
      "types": "./src/test-utils/index.ts",
      "import": "./src/test-utils/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@timeui/core": "workspace:*",
    "@timeui/themes": "workspace:*",
    "@timeui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "shiki": ">=1.0.0",
    "react-markdown": ">=9.0.0",
    "remark-gfm": ">=4.0.0",
    "@tiptap/core": ">=2.5.0",
    "@tiptap/react": ">=2.5.0",
    "@tiptap/pm": ">=2.5.0",
    "@tiptap/starter-kit": ">=2.5.0",
    "@tiptap/extension-underline": ">=2.5.0",
    "@tiptap/extension-link": ">=2.5.0",
    "@tiptap/extension-placeholder": ">=2.5.0",
    "codemirror": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/lang-css": "^6.0.0",
    "@codemirror/lang-html": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "pdfjs-dist": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    },
