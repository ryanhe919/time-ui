    },
    "@codemirror/lang-html": {
      "optional": true
    },
    "@codemirror/lang-json": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.13.3",
    "shiki": "^1.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "@tiptap/core": "^2.10.0",
