{
  "name": "@timeui/react",
  "version": "1.8.0",
  "description": "TimeUI — enterprise-grade React component library.",
  "license": "MIT",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "emotion",
    "timeui"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./code-block": {
      "types": "./dist/code-block.d.ts",
      "import": "./dist/code-block.js",
      "require": "./dist/code-block.cjs"
    },
    "./chat-markdown": {
      "types": "./dist/chat-markdown.d.ts",
      "import": "./dist/chat-markdown.js",
      "require": "./dist/chat-markdown.cjs"
    },
    "./test-utils": {
      "types": "./src/test-utils/index.ts",
      "import": "./src/test-utils/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@timeui/core": "workspace:*",
    "@timeui/themes": "workspace:*",
    "@timeui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "shiki": ">=1.0.0",
    "react-markdown": ">=9.0.0",
    "remark-gfm": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.13.3",
    "shiki": "^1.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest-axe": "^0.1.0",
    "axe-core": "^4.10.0",
    "rimraf": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
