    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest-axe": "^0.1.0",
    "axe-core": "^4.10.0",
    "rimraf": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
