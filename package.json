{
  "name": "timeui",
  "private": true,
  "version": "0.0.0",
  "description": "TimeUI — enterprise-grade React component library monorepo",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "stylelint": "stylelint \"packages/**/*.{ts,tsx}\" --allow-empty-input",
    "clean": "turbo run clean && rimraf node_modules",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:snapshot": "changeset version --snapshot canary && changeset publish --tag canary",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=\"./packages/*\" && changeset publish",
    "new:component": "node ./tools/create-component/bin/create-component.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.39.4",
    "@size-limit/preset-big-lib": "^11.1.6",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "size-limit": "^11.1.6",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "vite@<6.4.2": ">=6.4.2",
      "esbuild@<0.25.0": ">=0.25.0",
      "basic-ftp@<5.3.0": ">=5.3.0"
    }
  }
}
