{
  "name": "timeui",
  "private": true,
  "version": "0.0.0",
  "description": "TimeUI — enterprise-grade React component library monorepo",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "stylelint": "stylelint \"packages/**/*.{ts,tsx}\" --allow-empty-input",
    "clean": "turbo run clean && rimraf node_modules",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:snapshot": "changeset version --snapshot canary && changeset publish --tag canary",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=\"./packages/*\" && changeset publish",
    "new:component": "node ./tools/create-component/bin/create-component.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^15.5.15",
    "@size-limit/preset-big-lib": "^11.2.0",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "size-limit": "^11.2.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "vite@<6.4.2": ">=6.4.2",
      "esbuild@<0.25.0": ">=0.25.0",
      "basic-ftp@<5.3.0": ">=5.3.0",
      "postcss@<8.5.10": ">=8.5.10"
    },
    "ignoredBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  }
}
