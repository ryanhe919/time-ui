# Copy this file to `.env.local` and fill in real credentials.
# The docs assistant hits a MiniMax endpoint via the Anthropic-compatible layer.

# MiniMax Anthropic-compatible endpoint. Adjust if MiniMax changes the path.
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# Secret — never commit this.
ANTHROPIC_API_KEY=your-minimax-key-here

# MiniMax model name. Pick the one your account has access to.
ANTHROPIC_MODEL=MiniMax-M1

# Optional: set to 1 to enable Anthropic prompt caching markers on system + tools.
# MiniMax may not honor cache_control; leave empty to disable.
# ANTHROPIC_PROMPT_CACHE=1
