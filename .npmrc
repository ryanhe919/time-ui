auto-install-peers=true
shamefully-hoist=false
strict-peer-dependencies=false
# Fail pnpm install on moderate+ advisories from the registry
# (override per-invocation with `pnpm install --config.audit-level=...`).
audit-level=moderate
# Require the Node version declared in .nvmrc / package.json#engines.
engine-strict=true
# Never save tokens in the checked-in .npmrc; real tokens belong in CI secrets.
